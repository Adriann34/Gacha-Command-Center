# Copy this file to .env and fill in your Firebase project values
# Get these from: https://console.firebase.google.com → Project Settings → General → Your Apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# URL of the deployed Cloudflare schedule/Enka-proxy Worker (printed by `npm run deploy` in
# ../cloudflare-worker). Leave blank to disable the live schedule + character showcase features.
VITE_SCHEDULE_WORKER_URL=

# App Check reCAPTCHA v3 SITE key (public — safe in the bundle). Firebase Console → App Check →
# register the app with reCAPTCHA v3. Leave blank until set up; App Check stays inactive while
# empty. Once set, enable "Enforce" on Firestore + Auth in the console to block un-attested calls.
VITE_FIREBASE_APPCHECK_SITE_KEY=
